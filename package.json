{
  "name": "gamebuino-aka-pinball",
  "private": true,
  "version": "1.0.0",
  "description": "Suite de 12 flippers 240x320 (plateau 240x520) avec éditeur de tables JSON pour Gamebuino AKA tournée à 90°, Web et PC",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "clean": "node -e \"for (const d of ['dist','desktop/app','desktop/release']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "desktop:install": "npm --prefix desktop install",
    "desktop:sync": "npm run build && node desktop/scripts/sync-web.mjs",
    "desktop:dist": "npm run desktop:sync && npm --prefix desktop run dist",
    "aka:tables": "node scripts/gen-aka-tables.mjs",
    "aka:art": "node scripts/gen-aka-art.mjs",
    "aka:test": "bash firmware/aka_idf/test/host/run.sh",
    "aka:build": "idf.py -C firmware/aka_idf build",
    "aka:flash": "idf.py -C firmware/aka_idf flash monitor"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
