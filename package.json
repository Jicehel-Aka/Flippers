{
  "name": "gamebuino-aka-pinball",
  "private": true,
  "version": "1.0.0",
  "description": "Flipper arcade 240x320 (plateau 240x520) pour Gamebuino AKA tournée à 90°, Web et PC",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js desktop/app desktop/release",
    "lint": "tsc --noEmit",
    "desktop:install": "npm --prefix desktop install",
    "desktop:sync": "npm run build && node desktop/scripts/sync-web.mjs",
    "desktop:dist": "npm run desktop:sync && npm --prefix desktop run dist",
    "aka:build": "pio run -d firmware/gamebuino_aka -e gamebuino_aka",
    "aka:upload": "pio run -d firmware/gamebuino_aka -e gamebuino_aka -t upload"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
