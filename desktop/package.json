{
  "name": "gamebuino-aka-pinball-desktop",
  "productName": "Gamebuino AKA Pinball",
  "version": "1.0.0",
  "description": "Application PC autonome (Windows, Linux, macOS) pour Gamebuino AKA Pinball",
  "main": "main.cjs",
  "author": {
    "name": "Jean-Charles Lebeau",
    "email": "JeancharlesLebeau@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win portable zip --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage tar.gz --x64 --publish never",
    "dist:mac": "electron-builder --mac zip --publish never"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.gamebuino.aka.pinball",
    "productName": "Gamebuino AKA Pinball",
    "artifactName": "Gamebuino-AKA-Pinball-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ],
      "category": "Game",
      "synopsis": "Gamebuino AKA Pinball - 4 plateaux arcade 240x520"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.arcade-games",
      "identity": null
    }
  }
}
